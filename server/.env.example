# Copia este fichero como .env y ajusta los valores
PORT=3000
NODE_ENV=development

# MySQL (XAMPP por defecto: root sin contraseña)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=inventario_it

# Cambia este valor por una cadena larga y aleatoria
SESSION_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# URL pública (se usa para generar los QR: <PUBLIC_URL>/q/<codigo>)
PUBLIC_URL=http://localhost:3000

# Carpeta de adjuntos (fotos de incidencias, actas)
UPLOAD_DIR=../uploads
