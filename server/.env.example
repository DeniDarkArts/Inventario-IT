# Copia este fichero como .env y ajusta los valores
PORT=3000
NODE_ENV=development

# MySQL (XAMPP por defecto: root sin contraseña)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=inventario_it

# BD corporativa de usuarios (tabla users, contraseñas argon2id). Vacío = solo login local.
# Host/usuario/contraseña por defecto: los de DB_*; se cambian con AUTH_DB_HOST, AUTH_DB_USER, AUTH_DB_PASSWORD
AUTH_DB_NAME=ing039

# Cambia este valor por una cadena larga y aleatoria
SESSION_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# URL pública (se usa para generar los QR: <PUBLIC_URL>/q/<codigo>)
PUBLIC_URL=http://localhost:3000

# Carpeta de adjuntos (fotos de incidencias, actas)
UPLOAD_DIR=../uploads

# HTTPS de desarrollo (móvil en la red local). Certificado en server/certs/, fuera de git
HTTPS_PORT=3443
HTTPS_CERT=certs/dev-cert.pem
HTTPS_KEY=certs/dev-key.pem
